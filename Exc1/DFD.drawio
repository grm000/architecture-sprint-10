        <mxCell id="0yXHg2jgvJ0z2yU6XD0z-49" value="&lt;b&gt;Платежные данные&lt;/b&gt;&lt;div&gt;- Данные платежных карт (КАД)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="0yXHg2jgvJ0z2yU6XD0z-4" vertex="1">
